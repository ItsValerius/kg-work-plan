# Copy to .env.local for local development: cp .env.example .env.local

# Routes the database driver through the local wsproxy from docker-compose.yml
VERCEL_ENV=development
POSTGRES_URL=postgres://postgres:postgres@localhost:54320/kg_work_plan_dev

# Any long random string, e.g. from: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL; also the address AI assistants connect to (<BETTER_AUTH_URL>/api/mcp). Required in production.
BETTER_AUTH_URL=http://localhost:3000

# Magic-link emails go to Mailpit (docker-compose.yml); read them at http://localhost:8025
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=dev
EMAIL_SERVER_PASSWORD=dev
EMAIL_FROM=arbeitsplan@localhost

# Optional: Google sign-in (leave empty locally)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
